<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#6c63ff;stop-opacity:0.3"/>
      <stop offset="100%" style="stop-color:#00d4aa;stop-opacity:0.3"/>
    </linearGradient>
  </defs>
  <rect width="400" height="400" fill="#12121a"/>
  <circle cx="200" cy="200" r="180" fill="url(#bg)"/>
  <circle cx="200" cy="160" r="60" fill="#2a2a3e"/>
  <ellipse cx="200" cy="300" rx="90" ry="70" fill="#2a2a3e"/>
  <text x="200" y="380" text-anchor="middle" fill="#8a8a9a" font-family="Inter, sans-serif" font-size="14">Foto Profil</text>
</svg>
